# Sao chép thành .env rồi sửa. File .env KHÔNG được commit (đã có trong .gitignore).
# Không có biến nào là bắt buộc: mặc định chạy LLM offline + dữ liệu in-memory.

# --- LLM: offline | bedrock (Bedrock dùng credential AWS chuẩn: aws configure / IAM role, không đặt key ở đây)
PA_LLM_PROVIDER=offline
PA_AWS_REGION=us-east-1
PA_LLM_MODEL_ID=anthropic.claude-opus-5-5

# --- Lưu trữ (bỏ trống = in-memory)
# PA_DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/patient_assistant
# PA_CHECKPOINTER=postgres
# PA_CHECKPOINTER_URL=postgresql://user:pass@localhost:5432/patient_assistant

# --- STT (cần: pip install -e ".[stt]"; tiếng Việt dùng model đa ngôn ngữ, không dùng bản .en)
PA_STT_ENABLED=false
PA_STT_MODEL=small
