# Sao chép thành .env rồi sửa. File .env KHÔNG được commit (đã có trong .gitignore).
# Hệ thống bắt buộc gọi được Claude trên Bedrock: server không khởi động nếu không kết nối được LLM.
# Kiểm tra trước: python -m patient_assistant.interface.cli.check_llm

# --- LLM: Claude trên Bedrock (credential AWS chuẩn: aws configure / IAM role, không đặt key ở đây)
# Region/profile bỏ trống = theo AWS_REGION, AWS_PROFILE hoặc ~/.aws/config
PA_AWS_REGION=ap-southeast-1
# PA_AWS_PROFILE=default
PA_LLM_MODEL_ID=global.anthropic.claude-opus-4-6-v1

# --- Lưu trữ: chỉ PostgreSQL (bắt buộc), chạy bằng service `db` của docker compose:
#     docker compose up -d db
# URL dưới đây dùng khi chạy backend trực tiếp trên máy (cổng db chỉ mở cho localhost). Mật khẩu = POSTGRES_PASSWORD.
# Trong Docker, compose tự đặt URL trỏ tới service `db`.
PA_DATABASE_URL=postgresql+asyncpg://patient:doi-mat-khau-nay@127.0.0.1:5432/patient_assistant

# --- Đăng nhập. Tài khoản demo trong demo_data/users.json còn thiếu (theo username) được tạo mỗi lần seed,
# với mật khẩu dưới đây — đổi trước lần chạy đầu nếu DB không chỉ dùng trên máy mình.
PA_SEED_PASSWORD=demo1234
PA_SESSION_TTL_HOURS=12
# Service session-cleaner xóa phiên đã hết hạn khỏi DB mỗi chừng này phút
PA_SESSION_PURGE_EVERY_MINUTES=60
# Cho phép người dùng tự tạo tài khoản bệnh nhân ở trang /register
PA_ALLOW_REGISTRATION=true
# Bật khi chạy sau HTTPS (cookie chỉ gửi qua kết nối mã hóa)
PA_COOKIE_SECURE=false

# --- STT (cần: pip install -e ".[stt]"; tiếng Việt dùng model đa ngôn ngữ, không dùng bản .en)
# Docker: bật STT thì đặt cả BACKEND_EXTRAS=stt để image backend có faster-whisper, rồi build lại
# (docker compose up -d --build). Lần nhận dạng đầu tiên tải model (small ~480 MB) vào volume stt-models.
PA_STT_ENABLED=false
PA_STT_MODEL=small
# Ngôn ngữ mặc định của STT: en | vi | auto (tự nhận). Người dùng chọn lại được ngay trên giao diện.
PA_STT_LANGUAGE=en
# BACKEND_EXTRAS=stt

# --- Docker compose (docker compose up -d --build). Compose đọc file .env này để điền biến.
# Mật khẩu chỉ dùng chữ/số (hoặc URL-encode) vì được ghép vào connection URL.
POSTGRES_PASSWORD=doi-mat-khau-nay
# POSTGRES_USER=patient
# POSTGRES_DB=patient_assistant
# HTTP_PORT=8080
# DB_PORT=5432
# UVICORN_WORKERS=2
# Thư mục credential AWS mount (chỉ đọc) vào backend cho Bedrock
# AWS_CONFIG_DIR=~/.aws
# AWS_PROFILE=default
