# Sao chép thành .env rồi sửa. File .env KHÔNG được commit (đã có trong .gitignore).
# Không có biến nào là bắt buộc: mặc định chạy LLM offline + dữ liệu in-memory.

# --- LLM: offline | bedrock (Bedrock dùng credential AWS chuẩn: aws configure / IAM role, không đặt key ở đây)
PA_LLM_PROVIDER=offline
# Region/profile bỏ trống = theo AWS_REGION, AWS_PROFILE hoặc ~/.aws/config
PA_AWS_REGION=ap-southeast-1
# PA_AWS_PROFILE=default
PA_LLM_MODEL_ID=global.anthropic.claude-opus-4-6-v1

# --- Lưu trữ (bỏ trống = in-memory, mất khi tắt server). SQLite file: tài khoản, phiên đăng nhập,
# lịch sử câu hỏi, báo cáo, lịch hẹn được giữ lại qua các lần chạy.
PA_DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# PA_DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/patient_assistant
# PA_CHECKPOINTER=postgres
# PA_CHECKPOINTER_URL=postgresql://user:pass@localhost:5432/patient_assistant

# --- Đăng nhập. Tài khoản demo (benhnhan1..3, bacsi, admin) chỉ được tạo khi DB chưa có tài khoản nào,
# với mật khẩu dưới đây — đổi trước lần chạy đầu nếu DB không chỉ dùng trên máy mình.
PA_SEED_PASSWORD=demo1234
PA_SESSION_TTL_HOURS=12
# Bật khi chạy sau HTTPS (cookie chỉ gửi qua kết nối mã hóa)
PA_COOKIE_SECURE=false

# --- STT (cần: pip install -e ".[stt]"; tiếng Việt dùng model đa ngôn ngữ, không dùng bản .en)
PA_STT_ENABLED=false
PA_STT_MODEL=small

# --- Docker compose (docker compose up -d --build). Compose đọc file .env này để điền biến.
# Trong Docker, backend luôn dùng Postgres + checkpointer Postgres (PA_DATABASE_URL ở trên chỉ dùng khi chạy trực tiếp).
# Mật khẩu chỉ dùng chữ/số (hoặc URL-encode) vì được ghép vào connection URL.
POSTGRES_PASSWORD=doi-mat-khau-nay
# POSTGRES_USER=patient
# POSTGRES_DB=patient_assistant
# HTTP_PORT=8080
# UVICORN_WORKERS=2
# Thư mục credential AWS mount (chỉ đọc) vào backend cho Bedrock
# AWS_CONFIG_DIR=~/.aws
# AWS_PROFILE=default
